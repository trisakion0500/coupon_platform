# E2E 테스트(`npm run test:e2e`) 전용 DB 접속 정보 오버라이드. 이 파일을 `.env.test`로 복사해서
# 값을 채우면(`.env`와 동일한 방식) DB 리셋 스크립트와 실제 서버가 아래 값을 `.env`보다 우선
# 적용한다(test/utils/env.ts 참고) — 여기 없는 키(JWT_SECRET/ENCRYPTION_KEY 등)는 항상 `.env`를
# 그대로 재사용한다. `.env.test` 자체를 만들지 않으면 이전처럼 `.env`(dev DB)를 그대로 쓴다.
#
# ⚠️ `npm run test:e2e`는 여기 지정한 DB의 전 테이블을 매 실행마다 TRUNCATE한다 — 반드시
# dev DB와는 별도인, 언제든 밀어버려도 되는 스키마를 가리킬 것. 아래 이름의 DB/사용자 계정을
# 미리 만들고(docs/19_DEV_SETUP.md 3장과 동일한 절차로 스키마까지 적용) 값을 채워 넣는다.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coupon_platform_test

LOG_DB_HOST=localhost
LOG_DB_PORT=3306
LOG_DB_USER=root
LOG_DB_PASSWORD=
LOG_DB_NAME=coupon_platform_test_log
