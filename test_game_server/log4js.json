{
  "appenders": {
    "console": { "type": "console" },
    "file": {
      "type": "dateFile",
      "filename": "logs/app.log",
      "pattern": "yyyy-MM-dd",
      "keepFileExt": true,
      "numBackups": 30
    },
    "mismatchFile": {
      "type": "dateFile",
      "filename": "logs/mismatch.log",
      "pattern": "yyyy-MM-dd",
      "keepFileExt": true,
      "numBackups": 30
    }
  },
  "categories": {
    "default": { "appenders": ["console", "file"], "level": "info" },
    "mismatch": { "appenders": ["console", "mismatchFile"], "level": "warn" }
  }
}
