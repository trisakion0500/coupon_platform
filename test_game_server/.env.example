# backend/.env와 동일한 로컬 개발 DB 접속 정보를 그대로 넣는다 (docs/21_TEST_GAME_SERVER.md 2.3 — 로컬 개발 DB 전용, 운영 DB에 연결 금지)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=coupon_platform

# backend/.env와 동일값(64자 hex) — project.api_secret 복호화용
ENCRYPTION_KEY=

# coupon_platform 백엔드 주소
COUPON_SERVER_BASE_URL=http://localhost:3000

# 아래는 전부 선택값, 미지정 시 문서(docs/21_TEST_GAME_SERVER.md 4장) 기본값 사용
TICK_INTERVAL_MS=5000
GAME_USER_POOL_SIZE=50
CONFIRM_RATIO=0.9
RACE_BURST_COUNT=5
RECONCILE_RETRY_RATIO=0.5

# 가중치 6개 합은 반드시 100이어야 한다
SCENARIO_WEIGHT_NORMAL=60
SCENARIO_WEIGHT_IDEMPOTENT=10
SCENARIO_WEIGHT_RACE=10
SCENARIO_WEIGHT_EXHAUSTED=5
SCENARIO_WEIGHT_RECONCILE=10
SCENARIO_WEIGHT_ERROR=5
